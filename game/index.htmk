<div class="qad-event-log">
    ${
        state.events.length
            ? state.events
                .map(id => {
                    const event =
                        currentCase.events?.find(
                            e => e.id === id
                        );

                    return `
                        <div class="qad-event-item">
                            <strong>
                                ⚡
                                ${escapeHTML(
                                    event?.title ||
                                    "تطور جديد"
                                )}
                            </strong>

                            ${
                                event?.message
                                    ? `
                                    <span>
                                        ${escapeHTML(
                                            event.message
                                        )}
                                    </span>
                                    `
                                    : ""
                            }
                        </div>
                    `;
                })
                .join("")
            : `
                <span class="qad-muted">
                    لم تظهر أحداث مفاجئة بعد.
                </span>
            `
    }
</div>