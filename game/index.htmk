    <!-- =========================
         PRODUCT MODAL
    ========================== -->

    <div class="modal-overlay" id="productModal">
        <div class="product-modal">
            <button class="modal-close" id="closeProductModal">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="product-modal-content" id="productDetails">
                <!-- JavaScript -->
            </div>
        </div>
    </div>


    <!-- =========================
         CHECKOUT MODAL
    ========================== -->

    <div class="modal-overlay" id="checkoutModal">

        <div class="checkout-modal">

            <button class="modal-close" id="closeCheckoutModal">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="checkout-content">

                <div class="checkout-header">
                    <span class="section-label">خطوة أخيرة</span>
                    <h2>بيانات <span>الطلب</span></h2>
                    <p>اكتب بياناتك وإحنا هنتواصل معاك لتأكيد الطلب.</p>
                </div>


                <div class="checkout-grid">

                    <form id="checkoutForm" class="checkout-form">

                        <div class="form-group">
                            <label for="customerName">الاسم بالكامل *</label>
                            <div class="input-wrapper">
                                <i class="fa-regular fa-user"></i>
                                <input type="text" id="customerName" name="customerName" placeholder="اكتب اسمك بالكامل" required>
                            </div>
                            <small class="form-error" id="nameError"></small>
                        </div>


                        <div class="form-group">
                            <label for="customerPhone">رقم الموبايل *</label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-phone"></i>
                                <input type="tel" id="customerPhone" name="customerPhone" placeholder="مثال: 01012345678" inputmode="numeric" required>
                            </div>
                            <small class="form-error" id="phoneError"></small>
                        </div>


                        <div class="form-group">
                            <label for="customerAddress">العنوان *</label>
                            <div class="input-wrapper textarea-wrapper">
                                <i class="fa-solid fa-location-dot"></i>
                                <textarea id="customerAddress" name="customerAddress" placeholder="اكتب المحافظة والمنطقة والعنوان بالتفصيل" rows="4" required></textarea>
                            </div>
                            <small class="form-error" id="addressError"></small>
                        </div>


                        <div class="form-group">
                            <label for="customerNotes">ملاحظات <span>(اختياري)</span></label>
                            <div class="input-wrapper textarea-wrapper">
                                <i class="fa-regular fa-note-sticky"></i>
                                <textarea id="customerNotes" name="customerNotes" placeholder="أي ملاحظات على الطلب؟" rows="3"></textarea>
                            </div>
                        </div>


                        <button type="submit" class="btn btn-primary submit-order-btn">
                            تأكيد الطلب
                            <i class="fa-solid fa-check"></i>
                        </button>

                    </form>


                    <div class="checkout-summary">
                        <div class="summary-header">
                            <h3>ملخص الطلب</h3>
                            <span id="checkoutItemsCount">0 منتجات</span>
                        </div>

                        <div class="summary-products" id="checkoutItems">
                            <!-- JavaScript -->
                        </div>

                        <div class="summary-total">
                            <span>الإجمالي</span>
                            <strong id="checkoutTotal">0 جنيه</strong>
                        </div>

                        <div class="order-note">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>الطلب مش دفع أونلاين. هنراجع بياناتك ونتواصل معاك لتأكيد الطلب.</span>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         SUCCESS MODAL
    ========================== -->

    <div class="modal-overlay" id="successModal">

        <div class="success-modal">

            <div class="success-icon">
                <i class="fa-solid fa-check"></i>
            </div>

            <span class="section-label">تم بنجاح</span>

            <h2>استلمنا <span>طلبك 🎉</span></h2>

            <p>هنراجع بيانات الطلب ونتواصل معاك لتأكيده.</p>

            <div class="order-number-box">
                <span>رقم الطلب</span>
                <strong id="successOrderId">#AWT-00000</strong>
            </div>

            <div class="success-details">
                <div>
                    <span>العميل</span>
                    <strong id="successCustomerName">-</strong>
                </div>
                <div>
                    <span>الإجمالي</span>
                    <strong id="successTotal">-</strong>
                </div>
            </div>

            <div class="success-actions">
                <button class="btn btn-primary" id="successWhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                    ابعت الطلب على واتساب
                </button>
                <button class="continue-shopping" id="closeSuccess">
                    الرجوع للمتجر
                </button>
            </div>

        </div>

    </div>


    <!-- =========================
         ADMIN DASHBOARD
    ========================== -->
    <div class="admin-page" id="adminOverlay">

        <div class="admin-header">
            <div class="admin-header-left">
                <button class="admin-back-btn" id="closeAdmin" type="button">
                    <i class="fa-solid fa-arrow-right"></i>
                    المتجر
                </button>

                <div class="admin-title">
                    <span>AL WAFA TECH</span>
                    <strong id="adminPageTitle">لوحة التحكم</strong>
                </div>
            </div>

            <div class="admin-header-right">
                <span class="admin-status">
                    <span></span>
                    النظام يعمل
                </span>
                <button class="admin-mobile-close" id="adminMobileClose" type="button" aria-label="إغلاق لوحة التحكم">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <div class="container admin-container">

            <div class="admin-tabs">
                <button class="admin-nav-btn admin-tab active" data-admin-view="dashboard" type="button">
                    <i class="fa-solid fa-chart-line"></i>
                    الرئيسية
                </button>
                <button class="admin-nav-btn admin-tab" data-admin-view="products" type="button">
                    <i class="fa-solid fa-box"></i>
                    المنتجات
                </button>
                <button class="admin-nav-btn admin-tab" data-admin-view="orders" type="button">
                    <i class="fa-solid fa-cart-shopping"></i>
                    الطلبات
                </button>
            </div>

            <!-- DASHBOARD VIEW -->
            <div class="admin-panel active" id="adminDashboardView">
                <div class="admin-stats">
                    <div class="admin-stat">
                        <div>
                            <span>إجمالي المنتجات</span>
                            <strong id="statProducts">0</strong>
                        </div>
                        <i class="fa-solid fa-box"></i>
                    </div>

                    <div class="admin-stat">
                        <div>
                            <span>إجمالي الطلبات</span>
                            <strong id="statOrders">0</strong>
                        </div>
                        <i class="fa-solid fa-cart-shopping"></i>
                    </div>

                    <div class="admin-stat">
                        <div>
                            <span>طلبات جديدة</span>
                            <strong id="statNewOrders">0</strong>
                        </div>
                        <i class="fa-solid fa-bell"></i>
                    </div>
                </div>

                <span id="adminNewOrdersCount" hidden>0</span>

                <div class="admin-panel-header">
                    <div>
                        <span class="section-label">آخر الطلبات</span>
                        <h2>طلبات <span>العملاء</span></h2>
                    </div>
                    <button class="btn btn-primary" data-admin-view="orders" type="button">
                        عرض كل الطلبات
                    </button>
                </div>

                <div class="admin-orders-list" id="adminOrdersPreview">
                    <!-- JavaScript -->
                </div>
            </div>

            <!-- PRODUCTS VIEW -->
            <div class="admin-panel" id="adminProductsView">
                <div class="admin-panel-header">
                    <div>
                        <span class="section-label">إدارة المنتجات</span>
                        <h2>منتجات <span>المتجر</span></h2>
                    </div>

                    <button class="btn btn-primary" id="openAddProduct" type="button">
                        <i class="fa-solid fa-plus"></i>
                        إضافة منتج
                    </button>
                </div>

                <div class="admin-products-table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>المنتج</th>
                                <th>القسم</th>
                                <th>السعر</th>
                                <th>المخزون</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="adminProductsTable">
                            <!-- JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ORDERS VIEW -->
            <div class="admin-panel" id="adminOrdersView">
                <div class="admin-panel-header">
                    <div>
                        <span class="section-label">إدارة الطلبات</span>
                        <h2>طلبات <span>العملاء</span></h2>
                    </div>
                </div>

                <div class="admin-orders-list" id="adminOrdersList">
                    <!-- JavaScript -->
                </div>
            </div>

        </div>
    </div>


    <!-- =========================
         ADMIN PRODUCT MODAL
    ========================== -->

    <div class="modal-overlay" id="productAdminModal">

        <div class="admin-product-modal">

            <button class="modal-close" id="closeProductAdminModal">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="admin-modal-header">
                <span class="section-label">إدارة المنتجات</span>
                <h2 id="productAdminTitle">إضافة منتج</h2>
            </div>


            <form id="productAdminForm">

                <input type="hidden" id="editProductId">
                <input type="hidden" id="adminProductId">

                <div class="admin-form-grid">

                    <div class="form-group">
                        <label>اسم المنتج</label>
                        <input type="text" id="adminProductName" placeholder="مثال: iPhone 15" required>
                    </div>


                    <div class="form-group">
                        <label>القسم</label>
                        <select id="adminProductCategory" required>
                            <option value="Mobiles">موبايلات</option>
                            <option value="Cameras">كاميرات</option>
                            <option value="Laptops">لابتوب</option>
                            <option value="PC Builds">تجميعات PC</option>
                            <option value="Monitors">شاشات</option>
                        </select>
                    </div>


                    <div class="form-group">
                        <label>السعر بالجنيه</label>
                        <input type="number" id="adminProductPrice" min="0" placeholder="18999" required>
                    </div>


                    <div class="form-group">
                        <label>السعر قبل الخصم</label>
                        <input type="number" id="adminProductOldPrice" min="0" placeholder="19999">
                    </div>


                    <div class="form-group">
                        <label>المخزون</label>
                        <input type="number" id="adminProductStock" min="0" placeholder="10" required>
                    </div>


                    <div class="form-group">
                        <label>الشارة</label>
                        <select id="adminProductBadge">
                            <option value="">بدون شارة</option>
                            <option value="جديد">جديد</option>
                            <option value="عرض">عرض</option>
                            <option value="الأكثر مبيعًا">الأكثر مبيعًا</option>
                            <option value="مميز">مميز</option>
                        </select>
                    </div>

                </div>


                <div class="form-group">
                    <label>رابط / مسار الصورة</label>
                    <input type="text" id="adminProductImage" placeholder="assets/product.jpg">
                </div>


                <div class="form-group">
                    <label>الوصف</label>
                    <textarea id="adminProductDescription" rows="4" placeholder="اكتب وصف المنتج..." required></textarea>
                </div>


                <div class="form-group">
                    <label>المواصفات</label>
                    <textarea id="adminProductSpecs" rows="4" placeholder="اكتب كل مواصفة في سطر..."></textarea>
                </div>


                <button type="submit" class="btn btn-primary admin-submit-btn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    حفظ المنتج
                </button>

            </form>

        </div>

    </div>


    <!-- =========================
         TOAST
    ========================== -->

    <div class="toast-container" id="toastContainer"></div>


    <!-- =========================
         SCROLL TOP
    ========================== -->

    <button class="scroll-top" id="scrollTop" aria-label="العودة للأعلى">
        <i class="fa-solid fa-arrow-up"></i>
    </button>


    <!-- Main JavaScript -->
    <!-- استدعاء إعدادات فايربيز أولاً -->
<script type="module" src="firebase-config.js"></script>

<!-- بعده ملف الكود الرئيسي للموقع -->
<script src="app.js"></script>
 

</body>
</html>
