<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="الوفا تك - موبايلات، كاميرات مراقبة، إكسسوارات وأجهزة ذكية في مصر.">

    <title>الوفا تك | AL WAFA TECH</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Main CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- =========================
         ANNOUNCEMENT BAR
    ========================== -->
    <div class="announcement-bar">
        <div class="container announcement-content">
            <span>
                <i class="fa-solid fa-truck-fast"></i>
                اطلب بسهولة من موقعنا — وهنراجع طلبك ونتواصل معاك للتأكيد
            </span>

            <span class="announcement-trust">
                <i class="fa-solid fa-shield-halved"></i>
                خدمة موثوقة
            </span>
        </div>
    </div>


    <!-- =========================
         HEADER
    ========================== -->
    <header class="main-header" id="header">

        <div class="container header-content">

            <a href="#home" class="logo">
                <img src="assets/logo.png" alt="شعار الوفا تك">
            </a>

            <nav class="desktop-nav">
                <a href="#home" class="nav-link active">الرئيسية</a>
                <a href="#products" class="nav-link">المنتجات</a>
                <a href="#categories" class="nav-link">الأقسام</a>
                <a href="#about" class="nav-link">عن الوفا تك</a>
                <a href="#contact" class="nav-link">تواصل معانا</a>
            </nav>

            <div class="header-actions">

                <button class="icon-btn" id="searchToggle" aria-label="البحث">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>

                <button class="cart-btn" id="cartToggle" aria-label="السلة">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-counter" id="cartCounter">0</span>
                </button>

                <button
                    class="mobile-menu-btn"
                    id="mobileMenuToggle"
                    aria-label="فتح القائمة">
                    <i class="fa-solid fa-bars"></i>
                </button>

            </div>

        </div>


        <!-- SEARCH BAR -->
        <div class="search-wrapper" id="searchWrapper">
            <div class="container">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input
                        type="text"
                        id="searchInput"
                        placeholder="دور على منتج..."
                        autocomplete="off">

                    <button id="closeSearch" aria-label="إغلاق البحث">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
        </div>


        <!-- MOBILE MENU -->
        <div class="mobile-menu" id="mobileMenu">

            <a href="#home">الرئيسية</a>
            <a href="#products">المنتجات</a>
            <a href="#categories">الأقسام</a>
            <a href="#about">عن الوفا تك</a>
            <a href="#contact">تواصل معانا</a>

            <button class="mobile-whatsapp" id="mobileWhatsApp">
                <i class="fa-brands fa-whatsapp"></i>
                كلمنا على واتساب
            </button>

        </div>

    </header>


    <!-- =========================
         MAIN
    ========================== -->
    <main>


        <!-- =========================
             HERO
        ========================== -->
        <section class="hero" id="home">

            <div class="hero-background"></div>

            <div class="container hero-content">

                <div class="hero-text">

                    <span class="hero-label">
                        <span class="label-dot"></span>
                        تكنولوجيا بشكل مختلف
                    </span>

                    <h1>
                        كل اللي محتاجه من
                        <span>التكنولوجيا</span>
                        في مكان واحد
                    </h1>

                    <p>
                        موبايلات، كاميرات مراقبة، إكسسوارات وأجهزة ذكية —
                        اختيارات مميزة بأسعار مناسبة وخدمة تثق فيها.
                    </p>

                    <div class="hero-buttons">

                        <a href="#products" class="btn btn-primary">
                            شوف المنتجات
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>

                        <a href="#categories" class="btn btn-secondary">
                            تصفح الأقسام
                        </a>

                    </div>

                    <div class="hero-trust">

                        <div class="trust-item">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>اختيارات موثوقة</span>
                        </div>

                        <div class="trust-item">
                            <i class="fa-solid fa-headset"></i>
                            <span>خدمة مميزة</span>
                        </div>

                        <div class="trust-item">
                            <i class="fa-solid fa-bolt"></i>
                            <span>طلب سريع</span>
                        </div>

                    </div>

                </div>


                <div class="hero-visual">

                    <div class="hero-glow"></div>

                    <div class="hero-product-card">

                        <div class="floating-tag tag-one">
                            <i class="fa-solid fa-star"></i>
                            جودة مميزة
                        </div>

                        <div class="floating-tag tag-two">
                            <i class="fa-solid fa-bolt"></i>
                            عروض جديدة
                        </div>

                        <div class="hero-device">

                            <div class="device-screen">
                                <div class="screen-content">
                                    <span>AL WAFA</span>
                                    <strong>TECH</strong>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="hero-bottom-fade"></div>

        </section>


        <!-- =========================
             CATEGORIES
        ========================== -->
        <section class="section categories-section" id="categories">

            <div class="container">

                <div class="section-heading">

                    <div>
                        <span class="section-label">اختار اللي محتاجه</span>

                        <h2>
                            تصفح
                            <span>الأقسام</span>
                        </h2>
                    </div>

                    <p>
                        كل احتياجاتك التكنولوجية في مكان واحد.
                    </p>

                </div>


                <div class="categories-grid">

                    <button class="category-card" data-category="Mobiles">

                        <div class="category-image mobile-category">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                        </div>

                        <div class="category-info">
                            <span>01</span>
                            <h3>الموبايلات</h3>
                            <p>اختيارات تناسب استخدامك وميزانيتك</p>
                        </div>

                        <i class="fa-solid fa-arrow-left category-arrow"></i>

                    </button>


                    <button class="category-card" data-category="Cameras">

                        <div class="category-image camera-category">
                            <i class="fa-solid fa-video"></i>
                        </div>

                        <div class="category-info">
                            <span>02</span>
                            <h3>كاميرات المراقبة</h3>
                            <p>أمان ومراقبة للبيت والمحل والشركة</p>
                        </div>

                        <i class="fa-solid fa-arrow-left category-arrow"></i>

                    </button>


                    <button class="category-card" data-category="Accessories">

                        <div class="category-image accessories-category">
                            <i class="fa-solid fa-headphones"></i>
                        </div>

                        <div class="category-info">
                            <span>03</span>
                            <h3>الإكسسوارات</h3>
                            <p>شواحن، سماعات، كابلات وباور بانك</p>
                        </div>

                        <i class="fa-solid fa-arrow-left category-arrow"></i>

                    </button>


                    <button class="category-card" data-category="Smart Tech">

                        <div class="category-image smart-category">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                        <div class="category-info">
                            <span>04</span>
                            <h3>الأجهزة الذكية</h3>
                            <p>تكنولوجيا تخلي حياتك أسهل</p>
                        </div>

                        <i class="fa-solid fa-arrow-left category-arrow"></i>

                    </button>

                </div>

            </div>

        </section>


        <!-- =========================
             FEATURED PRODUCTS
        ========================== -->
        <section class="section products-section" id="products">

            <div class="container">

                <div class="section-heading products-heading">

                    <div>
                        <span class="section-label">اختياراتنا ليك</span>

                        <h2>
                            منتجات
                            <span>مميزة</span>
                        </h2>
                    </div>

                    <a href="#allProducts" class="view-all" id="viewAllProducts">
                        شوف كل المنتجات
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>

                </div>


                <!-- FILTERS -->
                <div class="product-filters" id="productFilters">

                    <button class="filter-btn active" data-filter="All">
                        الكل
                    </button>

                    <button class="filter-btn" data-filter="Mobiles">
                        الموبايلات
                    </button>

                    <button class="filter-btn" data-filter="Cameras">
                        كاميرات المراقبة
                    </button>

                    <button class="filter-btn" data-filter="Accessories">
                        الإكسسوارات
                    </button>

                    <button class="filter-btn" data-filter="Smart Tech">
                        الأجهزة الذكية
                    </button>

                </div>


                <!-- PRODUCTS -->
                <div class="products-grid" id="productsGrid">
                    <!-- JavaScript -->
                </div>


                <!-- EMPTY STATE -->
                <div class="empty-products" id="emptyProducts">

                    <div class="empty-icon">
                        <i class="fa-solid fa-box-open"></i>
                    </div>

                    <h3>ملقيناش منتجات مطابقة</h3>

                    <p>
                        جرب كلمة بحث مختلفة أو شوف كل المنتجات.
                    </p>

                    <button class="btn btn-primary" id="resetProducts">
                        عرض كل المنتجات
                    </button>

                </div>

            </div>

        </section>


        <!-- =========================
             PROMO
        ========================== -->
        <section class="promo-section">

            <div class="container">

                <div class="promo-banner">

                    <div class="promo-content">

                        <span class="promo-label">
                            AL WAFA TECH
                        </span>

                        <h2>
                            التكنولوجيا الصح
                            <br>
                            <span>تبدأ من الاختيار الصح.</span>
                        </h2>

                        <p>
                            لو محتار تختار إيه، كلمنا وهنساعدك تلاقي الأنسب ليك.
                        </p>

                        <button class="btn btn-primary" id="promoWhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                            كلمنا على واتساب
                        </button>

                    </div>

                    <div class="promo-decoration">
                        <div class="promo-circle circle-one"></div>
                        <div class="promo-circle circle-two"></div>
                        <div class="promo-lines"></div>
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             WHY US
        ========================== -->
        <section class="section why-section">

            <div class="container">

                <div class="section-heading centered">

                    <span class="section-label">ليه الوفا تك؟</span>

                    <h2>
                        تجربة شراء
                        <span>أسهل وأوضح</span>
                    </h2>

                    <p>
                        هدفنا إنك تلاقي اللي محتاجه بسهولة وتطلبه من غير تعقيد.
                    </p>

                </div>


                <div class="why-grid">

                    <div class="why-card">

                        <div class="why-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <h3>اختيارات موثوقة</h3>

                        <p>
                            بنركز على المنتجات اللي تقدم قيمة حقيقية مقابل السعر.
                        </p>

                    </div>


                    <div class="why-card">

                        <div class="why-icon">
                            <i class="fa-solid fa-tags"></i>
                        </div>

                        <h3>أسعار مناسبة</h3>

                        <p>
                            اختيارات متنوعة تناسب احتياجات وميزانيات مختلفة.
                        </p>

                    </div>


                    <div class="why-card">

                        <div class="why-icon">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>

                        <h3>طلب سهل</h3>

                        <p>
                            اختار منتجاتك وحط بياناتك وإحنا نتواصل معاك لتأكيد الطلب.
                        </p>

                    </div>


                    <div class="why-card">

                        <div class="why-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>

                        <h3>خدمة عملاء</h3>

                        <p>
                            عندك سؤال؟ تقدر تتواصل معانا ونساعدك في اختيار المنتج.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             ABOUT
        ========================== -->
        <section class="section about-section" id="about">

            <div class="container about-grid">

                <div class="about-visual">

                    <div class="about-box">

                        <span class="about-big-text">
                            AWT
                        </span>

                        <div class="about-logo-small">
                            <img src="assets/logo.png" alt="الوفا تك">
                        </div>

                    </div>

                </div>


                <div class="about-content">

                    <span class="section-label">عن الوفا تك</span>

                    <h2>
                        التكنولوجيا
                        <span>بشكل أبسط.</span>
                    </h2>

                    <p>
                        في الوفا تك بنحاول نوفرلك منتجات تكنولوجيا مختارة بعناية،
                        من الموبايلات وكاميرات المراقبة للإكسسوارات والأجهزة الذكية،
                        مع تجربة طلب سهلة وخدمة تركز على احتياجاتك.
                    </p>

                    <p>
                        هدفنا إنك تلاقي المنتج المناسب ليك من غير حيرة أو تعقيد.
                    </p>

                    <div class="about-stats">

                        <div>
                            <strong>01</strong>
                            <span>جودة</span>
                        </div>

                        <div>
                            <strong>02</strong>
                            <span>ثقة</span>
                        </div>

                        <div>
                            <strong>03</strong>
                            <span>خدمة</span>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             CONTACT CTA
        ========================== -->
        <section class="contact-section" id="contact">

            <div class="container">

                <div class="contact-box">

                    <div>
                        <span class="section-label">محتاج مساعدة؟</span>

                        <h2>
                            عندك سؤال
                            <span>عن منتج؟</span>
                        </h2>

                        <p>
                            كلمنا وهنساعدك تختار الأنسب ليك.
                        </p>
                    </div>

                    <button class="btn btn-primary whatsapp-btn" id="contactWhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                        كلمنا على واتساب
                    </button>

                </div>

            </div>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->
    <footer class="footer">

        <div class="container">

            <div class="footer-grid">

                <div class="footer-brand">

                    <a href="#home" class="footer-logo">
                        <img src="assets/logo.png" alt="AL WAFA TECH">
                    </a>

                    <p>
                        الوفا تك — كل احتياجاتك التكنولوجية في مكان واحد.
                    </p>

                    <div class="social-links">

                        <a href="#" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>

                        <a href="#" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>

                        <a href="#" aria-label="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>

                        <a href="#" id="footerWhatsApp" aria-label="WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>

                    </div>

                </div>


                <div class="footer-column">

                    <h3>روابط سريعة</h3>

                    <a href="#home">الرئيسية</a>
                    <a href="#products">المنتجات</a>
                    <a href="#categories">الأقسام</a>
                    <a href="#about">عن الوفا تك</a>

                </div>


                <div class="footer-column">

                    <h3>الأقسام</h3>

                    <a href="#products" data-footer-category="Mobiles">
                        الموبايلات
                    </a>

                    <a href="#products" data-footer-category="Cameras">
                        كاميرات المراقبة
                    </a>

                    <a href="#products" data-footer-category="Accessories">
                        الإكسسوارات
                    </a>

                    <a href="#products" data-footer-category="Smart Tech">
                        الأجهزة الذكية
                    </a>

                </div>


                <div class="footer-column">

                    <h3>تواصل معانا</h3>

                    <a href="#" id="footerPhone">
                        <i class="fa-solid fa-phone"></i>
                        01000000000
                    </a>

                    <a href="#" id="footerWhatsAppText">
                        <i class="fa-brands fa-whatsapp"></i>
                        واتساب
                    </a>

                    <span>
                        <i class="fa-solid fa-location-dot"></i>
                        مصر
                    </span>

                </div>

            </div>


            <div class="footer-bottom">

                <span>
                    © 2026 AL WAFA TECH — جميع الحقوق محفوظة
                </span>

                <span>
                    Made with <i class="fa-solid fa-heart"></i>
                </span>

            </div>

        </div>

    </footer>


    <!-- =========================
         CART DRAWER
    ========================== -->

    <div class="overlay" id="overlay"></div>

    <aside class="cart-drawer" id="cartDrawer">

        <div class="drawer-header">

            <div>
                <span>سلة المشتريات</span>
                <small id="cartItemsText">0 منتجات</small>
            </div>

            <button class="close-btn" id="closeCart" aria-label="إغلاق">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>


        <div class="cart-body" id="cartBody">

            <!-- JavaScript -->

        </div>


        <div class="cart-footer" id="cartFooter">

            <div class="cart-total">

                <span>الإجمالي</span>

                <strong id="cartTotal">
                    0 جنيه
                </strong>

            </div>

            <button class="btn btn-primary checkout-btn" id="checkoutBtn">
                إتمام الطلب
                <i class="fa-solid fa-arrow-left"></i>
            </button>

            <button class="continue-shopping" id="continueShopping">
                كمل تسوق
            </button>

        </div>

    </aside>


    <!-- =========================
         PRODUCT MODAL
    ========================== -->

    <div class="modal-overlay" id="productModal">

        <div class="product-modal">

            <button class="modal-close" id="closeProductModal">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="product-modal-content" id="productModalContent">
                <!-- JavaScript -->
            </div>

        </div>

    </div>


    <!-- =========================
         CHECKOUT MODAL
    ========================== -->

    <div class="modal-overlay" id="checkoutModal">

        <div class="checkout-modal">

            <button class="modal-close" id="closeCheckoutModal">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="checkout-content">

                <div class="checkout-header">

                    <span class="section-label">
                        خطوة أخيرة
                    </span>

                    <h2>
                        بيانات
                        <span>الطلب</span>
                    </h2>

                    <p>
                        اكتب بياناتك وإحنا هنتواصل معاك لتأكيد الطلب.
                    </p>

                </div>


                <div class="checkout-grid">

                    <form id="checkoutForm" class="checkout-form">

                        <div class="form-group">

                            <label for="customerName">
                                الاسم بالكامل *
                            </label>

                            <div class="input-wrapper">
                                <i class="fa-regular fa-user"></i>

                                <input
                                    type="text"
                                    id="customerName"
                                    name="customerName"
                                    placeholder="اكتب اسمك بالكامل"
                                    required>
                            </div>

                            <small class="form-error" id="nameError"></small>

                        </div>


                        <div class="form-group">

                            <label for="customerPhone">
                                رقم الموبايل *
                            </label>

                            <div class="input-wrapper">
                                <i class="fa-solid fa-phone"></i>

                                <input
                                    type="tel"
                                    id="customerPhone"
                                    name="customerPhone"
                                    placeholder="مثال: 01012345678"
                                    inputmode="numeric"
                                    required>
                            </div>

                            <small class="form-error" id="phoneError"></small>

                        </div>


                        <div class="form-group">

                            <label for="customerAddress">
                                العنوان *
                            </label>

                            <div class="input-wrapper textarea-wrapper">
                                <i class="fa-solid fa-location-dot"></i>

                                <textarea
                                    id="customerAddress"
                                    name="customerAddress"
                                    placeholder="اكتب المحافظة والمنطقة والعنوان بالتفصيل"
                                    rows="4"
                                    required></textarea>
                            </div>

                            <small class="form-error" id="addressError"></small>

                        </div>


                        <div class="form-group">

                            <label for="customerNotes">
                                ملاحظات
                                <span>(اختياري)</span>
                            </label>

                            <div class="input-wrapper textarea-wrapper">
                                <i class="fa-regular fa-note-sticky"></i>

                                <textarea
                                    id="customerNotes"
                                    name="customerNotes"
                                    placeholder="أي ملاحظات على الطلب؟"
                                    rows="3"></textarea>
                            </div>

                        </div>


                        <button
                            type="submit"
                            class="btn btn-primary submit-order-btn">

                            تأكيد الطلب

                            <i class="fa-solid fa-check"></i>

                        </button>

                    </form>


                    <div class="checkout-summary">

                        <div class="summary-header">
                            <h3>ملخص الطلب</h3>
                            <span id="summaryCount">0 منتجات</span>
                        </div>

                        <div
                            class="summary-products"
                            id="summaryProducts">
                            <!-- JavaScript -->
                        </div>

                        <div class="summary-total">

                            <span>الإجمالي</span>

                            <strong id="summaryTotal">
                                0 جنيه
                            </strong>

                        </div>

                        <div class="order-note">

                            <i class="fa-solid fa-circle-info"></i>

                            <span>
                                الطلب مش دفع أونلاين. هنراجع بياناتك ونتواصل معاك لتأكيد الطلب.
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         SUCCESS MODAL
    ========================== -->

    <div class="modal-overlay" id="successModal">

        <div class="success-modal">

            <div class="success-icon">
                <i class="fa-solid fa-check"></i>
            </div>

            <span class="section-label">
                تم بنجاح
            </span>

            <h2>
                استلمنا
                <span>طلبك 🎉</span>
            </h2>

            <p>
                هنراجع بيانات الطلب ونتواصل معاك لتأكيده.
            </p>

            <div class="order-number-box">

                <span>رقم الطلب</span>

                <strong id="successOrderId">
                    #AWT-00000
                </strong>

            </div>

            <div class="success-details">

                <div>
                    <span>العميل</span>
                    <strong id="successCustomerName">-</strong>
                </div>

                <div>
                    <span>الإجمالي</span>
                    <strong id="successTotal">-</strong>
                </div>

            </div>

            <div class="success-actions">

                <button
                    class="btn btn-primary"
                    id="successWhatsApp">

                    <i class="fa-brands fa-whatsapp"></i>
                    ابعت الطلب على واتساب

                </button>

                <button
                    class="continue-shopping"
                    id="successClose">

                    الرجوع للمتجر

                </button>

            </div>

        </div>

    </div>


    <!-- =========================
         ADMIN DASHBOARD
    ========================== -->

    <section class="admin-page" id="adminPage">

        <div class="admin-header">

            <div class="admin-header-left">

                <button class="admin-back-btn" id="adminBack">

                    <i class="fa-solid fa-arrow-right"></i>

                    المتجر

                </button>

                <div class="admin-title">

                    <span>AL WAFA TECH</span>

                    <strong>لوحة التحكم</strong>

                </div>

            </div>

            <div class="admin-header-right">

                <span class="admin-status">
                    <span></span>
                    النظام يعمل
                </span>

            </div>

        </div>


        <div class="container admin-container">

            <!-- DASHBOARD STATS -->

            <div class="admin-stats">

                <div class="admin-stat">

                    <div>
                        <span>إجمالي المنتجات</span>
                        <strong id="adminProductsCount">0</strong>
                    </div>

                    <i class="fa-solid fa-box"></i>

                </div>


                <div class="admin-stat">

                    <div>
                        <span>إجمالي الطلبات</span>
                        <strong id="adminOrdersCount">0</strong>
                    </div>

                    <i class="fa-solid fa-cart-shopping"></i>

                </div>


                <div class="admin-stat">

                    <div>
                        <span>طلبات جديدة</span>
                        <strong id="adminNewOrdersCount">0</strong>
                    </div>

                    <i class="fa-solid fa-bell"></i>

                </div>

            </div>


            <!-- ADMIN TABS -->

            <div class="admin-tabs">

                <button
                    class="admin-tab active"
                    data-admin-tab="products">

                    <i class="fa-solid fa-box"></i>
                    المنتجات

                </button>

                <button
                    class="admin-tab"
                    data-admin-tab="orders">

                    <i class="fa-solid fa-cart-shopping"></i>
                    الطلبات

                </button>

            </div>


            <!-- PRODUCTS ADMIN -->

            <div class="admin-panel active" id="adminProductsPanel">

                <div class="admin-panel-header">

                    <div>

                        <span class="section-label">
                            إدارة المنتجات
                        </span>

                        <h2>
                            منتجات
                            <span>المتجر</span>
                        </h2>

                    </div>

                    <button
                        class="btn btn-primary"
                        id="addProductBtn">

                        <i class="fa-solid fa-plus"></i>
                        إضافة منتج

                    </button>

                </div>


                <div class="admin-products-table-wrapper">

                    <table class="admin-table">

                        <thead>

                            <tr>
                                <th>المنتج</th>
                                <th>القسم</th>
                                <th>السعر</th>
                                <th>المخزون</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>

                        </thead>

                        <tbody id="adminProductsTable">
                            <!-- JavaScript -->
                        </tbody>

                    </table>

                </div>

            </div>


            <!-- ORDERS ADMIN -->

            <div class="admin-panel" id="adminOrdersPanel">

                <div class="admin-panel-header">

                    <div>

                        <span class="section-label">
                            إدارة الطلبات
                        </span>

                        <h2>
                            طلبات
                            <span>العملاء</span>
                        </h2>

                    </div>

                </div>


                <div class="admin-orders-list" id="adminOrdersList">
                    <!-- JavaScript -->
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         ADMIN PRODUCT MODAL
    ========================== -->

    <div class="modal-overlay" id="adminProductModal">

        <div class="admin-product-modal">

            <button class="modal-close" id="closeAdminProductModal">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="admin-modal-header">

                <span class="section-label">
                    إدارة المنتجات
                </span>

                <h2 id="adminProductModalTitle">
                    إضافة منتج
                </h2>

            </div>


            <form id="adminProductForm">

                <input type="hidden" id="adminProductId">

                <div class="admin-form-grid">

                    <div class="form-group">

                        <label>اسم المنتج</label>

                        <input
                            type="text"
                            id="adminProductName"
                            placeholder="مثال: iPhone 15"
                            required>

                    </div>


                    <div class="form-group">

                        <label>القسم</label>

                        <select id="adminProductCategory" required>

                            <option value="Mobiles">
                                الموبايلات
                            </option>

                            <option value="Cameras">
                                كاميرات المراقبة
                            </option>

                            <option value="Accessories">
                                الإكسسوارات
                            </option>

                            <option value="Smart Tech">
                                الأجهزة الذكية
                            </option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label>السعر بالجنيه</label>

                        <input
                            type="number"
                            id="adminProductPrice"
                            min="0"
                            placeholder="18999"
                            required>

                    </div>


                    <div class="form-group">

                        <label>السعر قبل الخصم</label>

                        <input
                            type="number"
                            id="adminProductOldPrice"
                            min="0"
                            placeholder="19999">

                    </div>


                    <div class="form-group">

                        <label>المخزون</label>

                        <input
                            type="number"
                            id="adminProductStock"
                            min="0"
                            placeholder="10"
                            required>

                    </div>


                    <div class="form-group">

                        <label>الشارة</label>

                        <select id="adminProductBadge">

                            <option value="">
                                بدون شارة
                            </option>

                            <option value="جديد">
                                جديد
                            </option>

                            <option value="عرض">
                                عرض
                            </option>

                            <option value="الأكثر مبيعًا">
                                الأكثر مبيعًا
                            </option>

                            <option value="مميز">
                                مميز
                            </option>

                        </select>

                    </div>

                </div>


                <div class="form-group">

                    <label>رابط / مسار الصورة</label>

                    <input
                        type="text"
                        id="adminProductImage"
                        placeholder="assets/product.jpg">

                </div>


                <div class="form-group">

                    <label>الوصف</label>

                    <textarea
                        id="adminProductDescription"
                        rows="4"
                        placeholder="اكتب وصف المنتج..."
                        required></textarea>

                </div>


                <div class="form-group">

                    <label>المواصفات</label>

                    <textarea
                        id="adminProductSpecifications"
                        rows="4"
                        placeholder="اكتب كل مواصفة في سطر..."></textarea>

                </div>


                <button
                    type="submit"
                    class="btn btn-primary admin-submit-btn">

                    <i class="fa-solid fa-floppy-disk"></i>

                    حفظ المنتج

                </button>

            </form>

        </div>

    </div>


    <!-- =========================
         TOAST
    ========================== -->

    <div class="toast-container" id="toastContainer"></div>


    <!-- =========================
         SCROLL TOP
    ========================== -->

    <button
        class="scroll-top"
        id="scrollTop"
        aria-label="العودة للأعلى">

        <i class="fa-solid fa-arrow-up"></i>

    </button>


    <!-- Main JavaScript -->
    <script src="app.js"></script>

</body>
</html>
